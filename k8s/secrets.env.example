# Copy to k8s/secrets.env (it is in .gitignore) and fill in your own values.
# kustomize turns the file into the Secret `vllm-secrets`.
# The HF token is only needed for private/gated models. For public ones (Qwen2.5) leave it EMPTY:
# Hugging Face rejects an invalid token with 401 even for public repos.
HF_TOKEN=
# Bearer token for clients: Authorization: Bearer <value>. Generate one with: openssl rand -hex 32
VLLM_API_KEY=change-me
