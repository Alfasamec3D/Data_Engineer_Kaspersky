# vLLM launch parameters. kustomize turns this file into the ConfigMap `vllm-config`
# (configMapGenerator in kustomization.yaml). The generated name carries a content hash, so
# after editing a value `kubectl apply -k k8s/` rolls the pod with the new settings, no image rebuild.
# Format: KEY=value, no quotes, comments only on their own lines.

# --- what to download and where to load from (read by both the initContainer and vLLM) ---
MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct
# pin a commit hash for reproducibility
MODEL_REVISION=main
MODEL_DIR=/models/Qwen2.5-1.5B-Instruct
SERVED_MODEL_NAME=qwen2.5-1.5b-instruct

# --- vLLM inference parameters (CPU) ---
# float32: on CPUs without AVX512_BF16/AMX (e.g. AVX2-only laptops) bf16 is emulated and ~7x slower;
# use bfloat16 (half the memory) on Xeons with AVX512_BF16/AMX
DTYPE=float32
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=2048
# GiB for the KV cache; must fit into the pod memory limit (fp32 weights take ~6 GiB)
VLLM_CPU_KVCACHE_SPACE=1
# pin OpenMP threads to (physical) cores
# VLLM_CPU_OMP_THREADS_BIND=0-3
# extra vLLM flags as a single string, e.g. --enable-prefix-caching
EXTRA_ARGS=--enforce-eager
