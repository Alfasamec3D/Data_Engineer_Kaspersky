{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "privacy": {
      "()": "vllm_privacy_logging.PromptRedactFilter"
    }
  },
  "formatters": {
    "vllm": {
      "class": "vllm.logging_utils.NewLineFormatter",
      "datefmt": "%m-%d %H:%M:%S",
      "format": "%(levelname)s %(asctime)s [%(filename)s:%(lineno)d] %(message)s"
    }
  },
  "handlers": {
    "vllm": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "level": "INFO",
      "filters": ["privacy"],
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {
      "handlers": ["vllm"],
      "level": "INFO",
      "propagate": false
    }
  }
}
